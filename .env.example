# POLARIS-X — Environment template
# Copy to .env and fill values. Never commit .env.

# ── Database ────────────────────────────────────────────
DATABASE_URL=mongodb://127.0.0.1:27017
MONGODB_URL=mongodb://127.0.0.1:27017
REDIS_URL=redis://127.0.0.1:6379

# ── Services ────────────────────────────────────────────
PORT=8200
PY_SERVICES_URL=http://127.0.0.1:8100
VITE_API_URL=http://localhost:8200
VITE_PY_URL=http://localhost:8100

# ── External data providers (optional — cached/demo data used otherwise) ──
MAP_PROVIDER_KEY=
WEATHER_PROVIDER_KEY=
SIC_PROVIDER_KEY=
ICEBERG_PROVIDER_KEY=
COPERNICUS_USER=
COPERNICUS_PASS=

# ── Model / Storage ────────────────────────────────────
MODEL_STORAGE_PATH=./data/models
OFFLINE_DATA_PATH=./data/normalized
OFFLINE_CACHE_DIR=./data/cache

# ── Auth (when enabled) ─────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
SESSION_SECRET=change-me
