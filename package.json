    "demo:video:short": "node tools/demo-video/bin/make-demo.mjs --short",
    "demo:dry": "node tools/demo-video/bin/make-demo.mjs --dry",
    "demo:preflight": "node tools/demo-video/bin/make-demo.mjs --only=preflight",
    "demo:narration": "node tools/demo-video/bin/make-demo.mjs --only=narration",
    "demo:assemble": "node tools/demo-video/bin/make-demo.mjs --only=assemble",
    "services": "node tools/demo-video/bin/make-demo.mjs --only=services --keep-services"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0"
